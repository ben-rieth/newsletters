HOST=localhost
PORT=8080
WEB_URL=http://localhost:3001
ENVIRONMENT="dev"
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/newsletters
JWT_SECRET=
RESEND_API_KEY=re_
NEWSLETTER_SENDER_EMAIL="newsletter@example.com"
JOB_QUEUE_SIZE=50
# Shared secret that Cloudflare's request header transform rule sends as
# X-Origin-Auth. Requests without it are refused, because Railway's edge serves
# the app to anyone who asks for its hostname directly, bypassing Cloudflare.
# Setting it also makes rate limiting trust Cloudflare's CF-Connecting-IP as the
# client address, since only Cloudflare traffic gets through.
# Required in prod (32+ characters, e.g. `openssl rand -hex 32`); leave empty in dev.
ORIGIN_AUTH_SECRET=
